import psycopg

HOST = "localhost"
PORT = 2005
USER = "postgres"
PASSWORD = "xxxx"
TARGET_DB = "DWH"


def transform_crm_prd_info():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute("DELETE FROM transformation.crm_prd_info;")

            cur.execute("""
                INSERT INTO transformation.crm_prd_info (
                    prd_id,
                    prd_key,
                    prd_nm,
                    prd_cost,
                    prd_line,
                    prd_start_dt,
                    prd_end_dt
                )
                SELECT
                    prd_id::text,
                    prd_key,
                    prd_nm,
                    prd_cost::text,
                    prd_line,
                    prd_start_dt::text,
                    prd_end_dt::text
                FROM ingestion.crm_prd_info;
            """)

        conn.commit()
        print("crm_prd_info transformed successfully")

    except Exception as e:
        conn.rollback()
        print("Error while transforming crm_prd_info:")
        print(e)

    finally:
        conn.close()


