def transform_crm_sales_details():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute("TRUNCATE TABLE transformation.crm_sales_details;")

            cur.execute("""
                INSERT INTO transformation.crm_sales_details (
                    sls_ord_num,
                    sls_prd_key,
                    sls_cust_id,
                    sls_order_dt,
                    sls_ship_dt,
                    sls_due_dt,
                    sls_sales,
                    sls_quantity,
                    sls_price
                )
                SELECT
                    TRIM(sls_ord_num),
                    TRIM(sls_prd_key),
                    sls_cust_id::text,
                    CASE
                        WHEN sls_ship_dt IS NOT NULL AND sls_order_dt > sls_ship_dt THEN NULL
                        ELSE sls_order_dt::text
                    END,
                    sls_ship_dt::text,
                    CASE
                        WHEN sls_due_dt IS NOT NULL AND sls_ship_dt IS NOT NULL AND sls_due_dt < sls_ship_dt THEN NULL
                        ELSE sls_due_dt::text
                    END,
                    CASE
                        WHEN (sls_sales IS NULL OR sls_sales <= 0) AND sls_price IS NOT NULL AND sls_price > 0
                            THEN sls_price::text
                        ELSE sls_sales::text
                    END,
                    CASE
                        WHEN sls_quantity IS NULL OR sls_quantity < 0 THEN NULL
                        ELSE sls_quantity::text
                    END,
                    CASE
                        WHEN (sls_price IS NULL OR sls_price <= 0) AND sls_sales IS NOT NULL AND sls_sales > 0
                            THEN sls_sales::text
                        ELSE sls_price::text
                    END
                FROM ingestion.crm_sales_details;
            """)

        conn.commit()
        print("crm_sales_details transformed successfully")

    except Exception as e:
        conn.rollback()
        print("Error while transforming crm_sales_details:")
        print(e)

    finally:
        conn.close()


def transform_erp_cust_az12():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute("TRUNCATE TABLE transformation.erp_cust_az12;")

            cur.execute("""
                INSERT INTO transformation.erp_cust_az12 (
                    cid,
                    bdate,
                    gen
                )
                SELECT
                    TRIM(cid),
                    CASE
                        WHEN bdate ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
                             AND TO_DATE(bdate, 'YYYY-MM-DD') > CURRENT_DATE THEN NULL
                        ELSE bdate
                    END,
                    CASE
                        WHEN TRIM(UPPER(gen)) = 'M' THEN 'Male'
                        WHEN TRIM(UPPER(gen)) = 'F' THEN 'Female'
                        WHEN TRIM(gen) = '' OR gen IS NULL THEN 'N/A'
                        ELSE TRIM(gen)
                    END
                FROM ingestion.erp_cust_az12;
            """)

        conn.commit()
        print("erp_cust_az12 transformed successfully")

    except Exception as e:
        conn.rollback()
        print("Error while transforming erp_cust_az12:")
        print(e)

    finally:
        conn.close()


