import psycopg
from psycopg import sql

HOST = "localhost"
PORT = 2005
USER = "postgres"
PASSWORD = "xxxx"
TARGET_DB = "DWH"
SCHEMA_NAME = "transformation"


def create_schema():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )
    conn.autocommit = True

    with conn.cursor() as cur:
        cur.execute(
            sql.SQL("CREATE SCHEMA IF NOT EXISTS {}").format(sql.Identifier(SCHEMA_NAME))
        )
        print(f"Schema '{SCHEMA_NAME}' created successfully")

    conn.close()


def create_tables():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute(
                sql.SQL("CREATE SCHEMA IF NOT EXISTS {}").format(sql.Identifier(SCHEMA_NAME))
            )
            cur.execute(
                sql.SQL("SET search_path TO {}").format(sql.Identifier(SCHEMA_NAME))
            )

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.erp_cust_az12 (
                    cid VARCHAR(50),
                    bdate VARCHAR(20),
                    gen VARCHAR(20)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.erp_loc_a101 (
                    cid VARCHAR(50),
                    cntry VARCHAR(100)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.erp_px_cat_g1v2 (
                    id VARCHAR(10),
                    cat VARCHAR(50),
                    subcat VARCHAR(75),
                    maintenance VARCHAR(50)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.crm_cust_info (
                    cst_id INT,
                    cst_key VARCHAR(50),
                    cst_firstname VARCHAR(50),
                    cst_lastname VARCHAR(50),
                    cst_marital_status VARCHAR(20),
                    cst_gndr VARCHAR(10),
                    cst_create_date VARCHAR(50)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.crm_prd_info (
                    prd_id VARCHAR(10),
                    prd_key VARCHAR(50),
                    prd_nm VARCHAR(100),
                    prd_cost VARCHAR(20),
                    prd_line VARCHAR(20),
                    prd_start_dt VARCHAR(20),
                    prd_end_dt VARCHAR(20)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS transformation.crm_sales_details (
                    sls_ord_num VARCHAR(50),
                    sls_prd_key VARCHAR(50),
                    sls_cust_id VARCHAR(50),
                    sls_order_dt VARCHAR(50),
                    sls_ship_dt VARCHAR(50),
                    sls_due_dt VARCHAR(50),
                    sls_sales VARCHAR(50),
                    sls_quantity VARCHAR(50),
                    sls_price VARCHAR(20)
                );
            """)

        conn.commit()
        print(f"All 6 tables created successfully in schema '{SCHEMA_NAME}'")

    except Exception as e:
        conn.rollback()
        print("Error while creating tables:")
        print(e)

    finally:
        conn.close()


def transform_crm_cust_info():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute("TRUNCATE TABLE transformation.crm_cust_info;")

            cur.execute("""
                INSERT INTO transformation.crm_cust_info (
                    cst_id,
                    cst_key,
                    cst_firstname,
                    cst_lastname,
                    cst_marital_status,
                    cst_gndr,
                    cst_create_date
                )
                SELECT
                    cst_id,
                    TRIM(cst_key),
                    NULLIF(TRIM(cst_firstname), ''),
                    NULLIF(TRIM(cst_lastname), ''),
                    CASE
                        WHEN TRIM(UPPER(cst_marital_status)) IN ('S', 'SINGLE') THEN 'Single'
                        WHEN TRIM(UPPER(cst_marital_status)) IN ('M', 'MARRIED') THEN 'Married'
                        WHEN TRIM(cst_marital_status) = '' OR cst_marital_status IS NULL THEN 'N/A'
                        ELSE TRIM(cst_marital_status)
                    END,
                    CASE
                        WHEN TRIM(UPPER(cst_gndr)) IN ('M', 'MALE') THEN 'Male'
                        WHEN TRIM(UPPER(cst_gndr)) IN ('F', 'FEMALE') THEN 'Female'
                        WHEN TRIM(cst_gndr) = '' OR cst_gndr IS NULL THEN 'N/A'
                        ELSE TRIM(cst_gndr)
                    END,
                    cst_create_date::text
                FROM ingestion.crm_cust_info;
            """)

        conn.commit()
        print("crm_cust_info transformed successfully")

    except Exception as e:
        conn.rollback()
        print("Error while transforming crm_cust_info:")
        print(e)

    finally:
        conn.close()


