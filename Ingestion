import psycopg
from psycopg import sql

HOST = "localhost"
PORT = 2005
USER = "postgres"
PASSWORD = "xxxx"
SOURCE_DB = "postgres"
TARGET_DB = "DWH"
SCHEMA_NAME = "ingestion"


def test_connection():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=SOURCE_DB,
        user=USER,
        password=PASSWORD
    )

    with conn.cursor() as cur:
        cur.execute("SELECT current_database(), current_user, version();")
        print(cur.fetchone())

    conn.close()


def create_database():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=SOURCE_DB,
        user=USER,
        password=PASSWORD
    )
    conn.autocommit = True

    try:
        with conn.cursor() as cur:
            cur.execute("SELECT 1 FROM pg_database WHERE datname = %s;", (TARGET_DB,))
            db_exists = cur.fetchone() is not None

            if db_exists:
                print(f"Database '{TARGET_DB}' already exists.")
            else:
                cur.execute(f'CREATE DATABASE "{TARGET_DB}";')
                print(f"Database '{TARGET_DB}' created successfully")
    finally:
        conn.close()


def create_schema():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )
    conn.autocommit = True

    with conn.cursor() as cur:
        cur.execute(f'CREATE SCHEMA IF NOT EXISTS "{SCHEMA_NAME}";')
        print(f"Schema '{SCHEMA_NAME}' created successfully")

    conn.close()


def create_tables():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute(
                sql.SQL("CREATE SCHEMA IF NOT EXISTS {}").format(sql.Identifier(SCHEMA_NAME))
            )
            cur.execute(
                sql.SQL("SET search_path TO {}").format(sql.Identifier(SCHEMA_NAME))
            )

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.crm_cust_info (
                    cst_id INT,
                    cst_key VARCHAR(50),
                    cst_firstname VARCHAR(50),
                    cst_lastname VARCHAR(50),
                    cst_marital_status VARCHAR(50),
                    cst_gndr VARCHAR(50),
                    cst_create_date DATE
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.crm_prd_info (
                    prd_id INT,
                    prd_key VARCHAR(50),
                    prd_nm VARCHAR(255),
                    prd_cost NUMERIC(12, 2),
                    prd_line VARCHAR(50),
                    prd_start_dt DATE,
                    prd_end_dt DATE
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.crm_sales_details (
                    sls_ord_num VARCHAR(50),
                    sls_prd_key VARCHAR(50),
                    sls_cust_id INT,
                    sls_order_dt VARCHAR(50),
                    sls_ship_dt VARCHAR(50),
                    sls_due_dt VARCHAR(50),
                    sls_sales NUMERIC(12, 2),
                    sls_quantity INT,
                    sls_price NUMERIC(12, 2)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.erp_cust_az12 (
                    cid VARCHAR(50),
                    bdate VARCHAR(50),
                    gen VARCHAR(20)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.erp_loc_a101 (
                    cid VARCHAR(50),
                    cntry VARCHAR(100)
                );
            """)

            cur.execute("""
                CREATE TABLE IF NOT EXISTS ingestion.erp_px_cat_g1v2 (
                    id VARCHAR(50),
                    cat VARCHAR(100),
                    subcat VARCHAR(100),
                    maintenance VARCHAR(100)
                );
            """)

        conn.commit()
        print(f"All 6 tables created successfully in schema '{SCHEMA_NAME}'")

    except Exception as e:
        conn.rollback()
        print("Error while creating tables:")
        print(e)

    finally:
        conn.close()


def load_data():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    files = [
        ("crm_cust_info", "/Users/lyaneleraky/Downloads/datasets/source_crm/cust_info.csv"),
        ("crm_prd_info", "/Users/lyaneleraky/Downnloads/datasets/source_crm/prd_info.csv"),
        ("crm_sales_details", "/Users/lyaneleraky/Downloads/datasets/source_crm/sales_details.csv"),
        ("erp_cust_az12", "/Users/lyaneleraky/Downloads/datasets/source_erp/CUST_AZ12.csv"),
        ("erp_loc_a101", "/Users/lyaneleraky/Downloads/datasets/source_erp/LOC_A101.csv"),
        ("erp_px_cat_g1v2", "/Users/lyaneleraky/Downloads/datasets/source_erp/PX_CAT_G1V2.csv")
    ]

    try:
        with conn.cursor() as cur:
            cur.execute(f'SET search_path TO "{SCHEMA_NAME}"')

            for table_name, file_path in files:
                with cur.copy(f"""
                    COPY {table_name}
                    FROM STDIN
                    WITH (FORMAT csv, HEADER true)
                """) as copy:
                    with open(file_path, "r", encoding="utf-8") as f:
                        for line in f:
                            copy.write(line)

                print(f"{table_name} loaded")

        conn.commit()
        print("All tables loaded successfully")

    except Exception as e:
        conn.rollback()
        print("Error occurred while loading data:")
        print(e)

    finally:
        conn.close()


def validate_data():
    conn = psycopg.connect(
        host=HOST,
        port=PORT,
        dbname=TARGET_DB,
        user=USER,
        password=PASSWORD
    )

    try:
        with conn.cursor() as cur:
            cur.execute(f'SET search_path TO "{SCHEMA_NAME}"')

            tables = [
                "crm_cust_info",
                "crm_prd_info",
                "crm_sales_details",
                "erp_cust_az12",
                "erp_loc_a101",
                "erp_px_cat_g1v2"
            ]

            print("\nData validation results:")
            for table_name in tables:
                cur.execute(f"SELECT COUNT(*) FROM {table_name};")
                row_count = cur.fetchone()[0]
                print(f"{table_name}: {row_count} rows")

    finally:
        conn.close()


def main():
    test_connection()
    create_database()
    create_schema()
    create_tables()
    load_data()
    validate_data()


if _name_ == "_main_":
    main()
